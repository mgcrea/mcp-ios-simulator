{
  "name": "@mgcrea/mcp-ios-simulator",
  "version": "0.3.1",
  "description": "Model Context Protocol server for driving iOS Simulators: screenshots, UI tree, taps, app lifecycle and device staging",
  "keywords": [
    "ios",
    "mcp",
    "model-context-protocol",
    "simctl",
    "simulator",
    "webdriveragent"
  ],
  "homepage": "https://github.com/mgcrea/mcp-ios-simulator#readme",
  "license": "MIT",
  "author": "Olivier Louvignes <olivier@mgcrea.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mgcrea/mcp-ios-simulator.git"
  },
  "bin": {
    "ios-simulator-mcp": "dist/cli.js",
    "ios-simulator-wda": "scripts/wda.sh",
    "mcp-ios-simulator": "dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/wda.sh"
  ],
  "os": [
    "darwin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "pnpm dlx release-it",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@mgcrea/mcp-ios-core": "^0.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.13.1"
}
